{
  "name": "projects/PROJECT_ID/iap_web/services/agent-gateway-backend",
  "bindings": [
    {
      "role": "roles/iap.httpsResourceAccessor",
      "members": [
        "serviceAccount:mortgage-evaluator-sa@PROJECT_ID.iam.gserviceaccount.com"
      ],
      "condition": {
        "title": "ReadOnlyToolsOnly",
        "description": "Restricts automated agent identity from invoking write or email tools",
        "expression": "request.headers[\"X-MCP-Tool-Name\"] in [\"search_applicant_tax_records\", \"verify_employment_and_income\"]"
      }
    },
    {
      "role": "roles/iap.httpsResourceAccessor",
      "members": [
        "group:senior-underwriters@enterprise.com"
      ],
      "condition": {
        "title": "SeniorUnderwriterFullAccess",
        "description": "Senior Underwriters can authorize notification dispatches",
        "expression": "true"
      }
    }
  ]
}